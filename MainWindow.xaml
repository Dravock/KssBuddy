<Window x:Class="KssBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSS Buddy"
        Width="420" Height="552"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="200" Top="150">

    <!-- 3D-Bühne mit orthografischer Kamera: Das Charakterbild liegt als Textur auf einem verformbaren Gitter
         (siehe Rendering/PuppetMesh.cs). Szene-Breite 950 Einheiten = 1.3x Bildbreite, damit Platz für
         erhobene Arme und Hüpfer bleibt. Das Mesh wird in Code hinzugefügt. -->
    <Grid>
    <Viewport3D x:Name="Stage" ClipToBounds="True">
        <!-- Kamera wird in MainWindow.xaml.cs pro Figur gesetzt -->
        <Viewport3D.Camera>
            <OrthographicCamera Position="312,560,10" LookDirection="0,0,-1" UpDirection="0,1,0" Width="950" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup x:Name="Scene" />
            </ModelVisual3D.Content>
        </ModelVisual3D>
    </Viewport3D>
    <!-- Video-Clips (PNG-Sequenz mit Alpha), liegen über der 3D-Bühne, solange ein Clip läuft -->
    <Image x:Name="VideoLayer" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
    <Image x:Name="VideoLayerNext" Stretch="Fill" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</Window>
