<Window x:Class="KssBuddy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSS Buddy – Einstellungen"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#FF1F1F26" Foreground="#FFE8E8EE" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFE8E8EE" /></Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8E8EE" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF9AB8FF" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,6,20,18">

        <TextBlock Text="Figur" Style="{StaticResource Header}" />
        <ComboBox x:Name="CharacterBox" DisplayMemberPath="DisplayName" SelectionChanged="OnCharacterChanged" />

        <TextBlock Text="Darstellung" Style="{StaticResource Header}" />
        <DockPanel>
            <TextBlock Text="Größe" Width="80" VerticalAlignment="Center" />
            <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" Width="50" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="ScaleSlider" Minimum="50" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                    ValueChanged="OnScaleChanged" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <TextBlock Text="Deckkraft" Width="80" VerticalAlignment="Center" />
            <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="50" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="OnOpacityChanged" />
        </DockPanel>

        <TextBlock Text="Fenster" Style="{StaticResource Header}" />
        <CheckBox x:Name="TopmostBox" Content="Immer im Vordergrund" Click="OnTopmostClicked" />
        <CheckBox x:Name="ClickThroughBox" Content="Click-Through (Klicks gehen durch die Figur; zurückschalten im Tray-Menü)"
                  Click="OnClickThroughClicked" />

        <TextBlock Text="Verhalten" Style="{StaticResource Header}" />
        <CheckBox x:Name="AutoBox" Content="Von selbst strecken und winken (alle 1–2 Minuten)" Click="OnAutoClicked" />
        <CheckBox x:Name="FullscreenBox" Content="Bei Vollbild-Anwendungen pausieren" Click="OnFullscreenClicked" />
        <CheckBox x:Name="AutostartBox" Content="Mit Windows starten" Click="OnAutostartClicked" />
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Bildrate" Width="80" VerticalAlignment="Center" />
            <ComboBox x:Name="FpsBox" Width="150" HorizontalAlignment="Left" SelectionChanged="OnFpsChanged">
                <ComboBoxItem Content="15 FPS (sparsam)" Tag="15" />
                <ComboBoxItem Content="30 FPS (Standard)" Tag="30" />
                <ComboBoxItem Content="60 FPS (flüssig)" Tag="60" />
            </ComboBox>
        </DockPanel>

        <TextBlock Text="Animationen ausprobieren" Style="{StaticResource Header}" />
        <WrapPanel>
            <Button Content="Idle" Tag="idle" Click="OnAnimClicked" />
            <Button Content="Winken" Tag="wave" Click="OnAnimClicked" />
            <Button Content="Tanzen" Tag="dance" Click="OnAnimClicked" />
            <Button Content="UwU-Tanz" Tag="uwu" Click="OnAnimClicked" />
            <Button Content="Gähnen" Tag="yawn" Click="OnAnimClicked" />
            <Button Content="Jubeln" Tag="cheer" Click="OnAnimClicked" />
            <Button Content="Strecken" Tag="stretch" Click="OnAnimClicked" />
            <Button Content="Ermahnen" Tag="scold" Click="OnAnimClicked" />
            <Button Content="Hüftschwung" Tag="hips" Click="OnAnimClicked" />
            <Button Content="Schüchtern" Tag="shy" Click="OnAnimClicked" />
            <Button Content="Einnicken" Tag="sleepy" Click="OnAnimClicked" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Position zurücksetzen" Click="OnResetPosition" />
            <Button Content="Schließen" IsDefault="True" Click="OnClose" Margin="0,0,0,6" />
        </StackPanel>
    </StackPanel>
</Window>
